# The public package is checked against its build manifest on every deployment.
# Preserve bytes across checkouts, including CSV and generated PCB assets.
sem/lab/** -text
sem/lab/**/exports/** -whitespace
sem/lab/**/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve exported simulation evidence bytes for integrity checks.
rk3566/data/** -text -diff
rk3566/artifacts/** -text -diff -whitespace
rk3566/vendor/** -text -whitespace
