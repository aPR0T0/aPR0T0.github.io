(sheet (at 20.32 45.72) (size 177.8 25.4) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid "dc95bc65-efb7-5e52-bece-26b0abd16ba9") (property "Sheetname" "Guarded LMC662 current acquisition / ADS1115" (at 20.32 44.449999999999996 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Sheetfile" "current12_analog.kicad_sch" (at 20.32 72.39 0) (effects (font (size 1.27 1.27)) (justify left top))) (instances (project "current12" (path "/d74c74ca-bddb-535a-8d59-f48519357079" (page "2")))))
(text "J1 SUM -> guarded LMC662 -> conditioning -> ADS1115.\n100 Mohm feedback, 10 pF; all local voltages reference AGND.\nPreserved 16 mm SUM trace; no copper plane under the input." (at 25.4 50.8 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "149f29cd-b048-57c3-a504-d4ff4e0eeac4"))
(sheet (at 20.32 81.28) (size 177.8 25.4) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid "67b130b2-9538-563c-b795-cd5dfdb893db") (property "Sheetname" "9-30 V input / onboard buck / isolated converter" (at 20.32 80.01 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Sheetfile" "current12_power.kicad_sch" (at 20.32 107.95 0) (effects (font (size 1.27 1.27)) (justify left top))) (instances (project "current12" (path "/d74c74ca-bddb-535a-8d59-f48519357079" (page "3")))))
(text "J2 regulated 9-30 V DC -> fuse -> reverse diode -> buck.\nLMR51420XF: 500 kHz forced PWM; 5.08889 V nominal.\nR05P09D/P provides isolated raw positive/negative rails." (at 25.4 86.36 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "8973e90d-678b-5b38-8a9a-869f51defb7e"))
(sheet (at 20.32 116.84) (size 177.8 25.4) (fields_autoplaced yes) (stroke (width .254) (type default)) (fill (color 0 0 0 0)) (uuid "00799e20-f7ce-5d55-8650-c061d1605d75") (property "Sheetname" "Filtered local +/-5 V detector rails" (at 20.32 115.57000000000001 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Sheetfile" "current12_power_rails.kicad_sch" (at 20.32 143.51 0) (effects (font (size 1.27 1.27)) (justify left top))) (instances (project "current12" (path "/d74c74ca-bddb-535a-8d59-f48519357079" (page "4")))))
(text "Raw +/-9 V -> preload and RC filters -> TPS7A regulators.\nQuiet +5VA and -5VA reference AGND; local 3.3 V for ADC.\n55 mA per raw rail; verify ripple, headroom and temperature." (at 25.4 121.92 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "ba779b95-73ef-588b-b223-a6a39af2a7a9"))
(text "POWER AND REFERENCE" (at 220 45.72 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "fa3114f6-afae-51de-93e7-e813693c8fd6"))
(text "Input: regulated 9-30 V DC, nominal 12 or 24 V.\nBuck: 5.08889 V nominal; divider resistors 0.1%.\nAnalog: +5VA / -5VA and local 3.3 V.\nAGND joins PGND only at R149 beside the converter input return.\nESP32 is powered separately. No gun or filament connection." (at 220 55.88 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "c200719a-5582-5149-a7f2-b2551f7c859a"))
(text "SIGNAL AND CONNECTORS" (at 220 93.98 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "6aeeb60f-f726-5895-b983-e70f26d771ce"))
(text "J1: 1 SUM specimen input, 2 AGND guard / shield.\nJ2: 1 VIN, 2 PGND. J4: both pins PGND / chamber.\nJ3: 1 GND, 2 reference output, 3 SDA, 4 SCL, 5 RDY.\nSDA -> ESP32 GPIO21; SCL -> GPIO22; RDY optional." (at 220 104.14 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "21a758fe-caf4-50ec-a5af-1f19992b766f"))
(text "MECHANICAL AND VALIDATION" (at 220 139.7 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "4e1b344a-fba7-5d78-839d-e31396ec4d30"))
(text "170 x 100 mm, two copper layers, four 3.2 mm NPTH holes.\nUse insulating nylon / PEEK fasteners and standoffs.\nNative ERC/DRC and pin-map audits accompany the package.\nThese checks do not establish measured analog performance." (at 220 149.86 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "1b63635a-369f-52d8-a098-c4e98ea08969"))
(text "UNBUILT ENGINEERING PROTOTYPE" (at 220 185.42 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "c8369900-869f-5775-8159-e11704c5a891"))
(text "Validate leakage, noise, stability, settling and calibration.\nInspect construction and clean the high-impedance input.\nNo measured sensitivity or microscope resolution is claimed.\nCommission first with a current-limited bench supply.\nCheck rails and detector baseline before microscope wiring." (at 220 195.58 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "1f7e3e64-ed9f-5b16-9c9f-f8b94caf8b54"))
