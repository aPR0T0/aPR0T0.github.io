(text "01 GUARDED TRANSIMPEDANCE" (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "5896dfca-e7ef-5aab-9193-a4528ffab68f"))
(text "02 ADC CONDITIONING" (at 116.84 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "8b4340fb-d08b-50de-b1be-0d62965b0e1d"))
(text "03 DIFFERENTIAL ADC" (at 241.3 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "7e1bc425-5138-5a3b-b05c-f0df2621fc02"))
(text "All voltages on this sheet reference FCOM.\nSUM has no clamp or probe point. R1 || C1: 1 ms nominal.\nI_abs electron deposition gives V_TIA = +I_abs x 100 Mohm.\nDo not connect SUM directly to the bias supply." (at 15.24 111.76 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "33e90008-fee4-5ca9-b9f4-14e780444562"))
(text "V_A0 = 1.648358 - (10/40.2) V_TIA\nV_A1 = 1.650 V nominal. Dark-zero and gain calibration required.\nPGA +/-256 mV gives 0.3141 pA per raw code; not measured sensitivity." (at 154.94 119.38 0) (effects (font (size 1.08 1.08)) (justify left top)) (uuid "28e75af4-6313-531c-aa17-2d5646f77c43"))
(text "04 LOCAL BYPASS / QUIET ADC REFERENCE" (at 15.24 172.72 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "8a13db1d-0127-5b53-8fee-30a246aa809b"))
(text "UNBUILT PROTOTYPE\nNo measured leakage, noise, stability, settling, or imaging resolution.\nLMC662 and feedback geometry preserved from the original detector." (at 200.66 248.92 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "0e0a3bfd-8110-5a4f-a1c4-7cd93e56dc0d"))
