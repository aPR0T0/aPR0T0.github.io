(version 1)
(rule "Bias nets to other primary copper" (condition "(A.NetName == 'HV_RAW' || A.NetName == 'HV_FILTER' || A.NetName == 'RAW_BLEED_MID' || A.NetName == 'FILTER_BLEED_MID') && A.NetName != B.NetName") (constraint clearance (min 2mm)))
(rule "Primary to FCOM domain" (condition "(A.NetName == 'BUCK5' || A.NetName == 'BUCK_CB' || A.NetName == 'BUCK_EN' || A.NetName == 'BUCK_FB' || A.NetName == 'BUCK_SW' || A.NetName == 'CLAMP_GATE' || A.NetName == 'FILTER_BLEED_MID' || A.NetName == 'HOST_RX' || A.NetName == 'HOST_TX' || A.NetName == 'HOST_VIO' || A.NetName == 'HV_DELAY' || A.NetName == 'HV_ENABLE' || A.NetName == 'HV_FAULT_N' || A.NetName == 'HV_FILTER' || A.NetName == 'HV_ILIM' || A.NetName == 'HV_MODULE_5' || A.NetName == 'HV_MON' || A.NetName == 'HV_PROGRAM' || A.NetName == 'HV_RAW' || A.NetName == 'HV_REF' || A.NetName == 'HV_SET_WIPER' || A.NetName == 'HV_SUPPLY_READY' || A.NetName == 'PGM_FILTER' || A.NetName == 'PGM_RELEASE' || A.NetName == 'PGND' || A.NetName == 'RAW_BLEED_MID' || A.NetName == 'RELEASE_BASE' || A.NetName == 'RELEASE_EMITTER' || A.NetName == 'SEQUENCE_BASE' || A.NetName == 'U7_LED_A' || A.NetName == 'VIN' || A.NetName == 'VIN_FUSED' || A.NetName == 'VIN_PROTECTED') && (B.NetName == '+3V3' || B.NetName == '+3V3D' || B.NetName == '+5VA' || B.NetName == '-5VA' || B.NetName == 'ADC_DRIVE' || B.NetName == 'AIN0' || B.NetName == 'AREF' || B.NetName == 'AVCC' || B.NetName == 'FCOM' || B.NetName == 'INV' || B.NetName == 'MCU_RX' || B.NetName == 'MCU_TX' || B.NetName == 'MISO' || B.NetName == 'MOSI' || B.NetName == 'NEG_FB' || B.NetName == 'NEG_FILTERED' || B.NetName == 'NEG_NR' || B.NetName == 'POS_FB' || B.NetName == 'POS_FILTERED' || B.NetName == 'POS_NR' || B.NetName == 'RAW_NEG9' || B.NetName == 'RAW_POS9' || B.NetName == 'RDY' || B.NetName == 'RESET' || B.NetName == 'SCK' || B.NetName == 'SCL' || B.NetName == 'SDA' || B.NetName == 'SUM' || B.NetName == 'TIA' || B.NetName == 'U6_LED_A' || B.NetName == 'VBIAS' || B.NetName == 'VMID' || B.NetName == 'XTAL1' || B.NetName == 'XTAL2')") (constraint clearance (min 5mm)))
