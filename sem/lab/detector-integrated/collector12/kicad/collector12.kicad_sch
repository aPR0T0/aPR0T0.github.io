(text "J1 SUM -> guarded LMC662 -> conditioning -> ADS1115.\n100 Mohm feedback, 10 pF; all local voltages reference FCOM.\nPreserved 16 mm SUM trace; no copper plane under the input." (at 25.4 50.8 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "c2ede128-630b-598e-873d-160c44bf28a4"))
